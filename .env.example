# EVIDENTIA Environment Configuration
# Copy this file to .env.local for local development.

# -----------------------------------------------------------------------------
# SUPABASE PUBLIC CONFIGURATION (Safe for browser client)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# -----------------------------------------------------------------------------
# SUPABASE PRIVILEGED CREDENTIALS (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# -----------------------------------------------------------------------------
# CRYPTOGRAPHIC KEYS & SECRETS (SERVER-SIDE ONLY)
# -----------------------------------------------------------------------------
# 32-byte hex-encoded AES-256-GCM master encryption key for envelope encryption
EVIDENTIA_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Ed25519 system attestation private signing key (PKCS#8 PEM or hex-encoded 32-byte seed)
EVIDENTIA_SIGNING_PRIVATE_KEY=302e020100300506032b657004220420...

# Ed25519 system attestation public verification key (SPKI PEM or hex-encoded 32-byte public key)
NEXT_PUBLIC_EVIDENTIA_SIGNING_PUBLIC_KEY=302a300506032b6570032100...

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="EVIDENTIA"
DEMO_MODE=true
